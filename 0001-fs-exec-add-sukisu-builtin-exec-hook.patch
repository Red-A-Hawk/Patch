+#ifdef CONFIG_KSU
+extern bool ksu_execveat_hook;
+extern bool ksu_boot_completed;
+
+extern int ksu_handle_execveat(
+        int *fd,
+        struct filename **filename,
+        void *argv,
+        void *envp,
+        int *flags);
+
+extern int ksu_handle_execveat_sucompat(
+        int *fd,
+        struct filename **filename,
+        void *argv,
+        void *envp,
+        int *flags);
+
+#ifdef CONFIG_KSU_SUSFS
+if (unlikely(susfs_is_current_proc_umounted()))
+        goto orig_flow;
+#endif
+
+if (unlikely(ksu_execveat_hook || !ksu_boot_completed)) {
+        ksu_handle_execveat(&fd, &filename, &argv, &envp, &flags);
+} else if (__ksu_is_allow_uid_for_current(current_uid().val)) {
+        ksu_handle_execveat_sucompat(&fd, &filename, &argv, &envp, &flags);
+}
+
+orig_flow:
+#endif /* CONFIG_KSU */

 		if (cmd == CMD_SUSFS_ENABLE_AVC_LOG_SPOOFING) {
-			susfs_set_avc_log_spoofing(arg);
+			bool enable;
+
+			if (copy_from_user(&enable, argp, sizeof(enable)) == 0)
+				susfs_set_avc_log_spoofing(enable);
 			return 0;
 		}
+
 		return 0;
 	}

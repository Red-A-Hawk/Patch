diff --git a/drivers/kernelsu/supercalls.c b/drivers/kernelsu/supercalls.c
index 7d3a9c1..e4b8f2a 100644
--- a/drivers/kernelsu/supercalls.c
+++ b/drivers/kernelsu/supercalls.c
@@ -926,6 +926,14 @@ static int ksu_handle_fd_request(void __user *arg)
 int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd,
 			  void __user **arg)
 {
+	void __user *argp;
+
+	if (!arg)
+		return 0;
+
+	argp = (void __user *)*arg;
+
 	if (magic1 != KSU_INSTALL_MAGIC1) {
 		return -EINVAL;
 	}
@@ -933,15 +941,13 @@ int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd,
-	if (magic2 == SUSFS_MAGIC && current_uid().val == 0) {
+	if (current_uid().val == 0) {
 #ifdef CONFIG_KSU_SUSFS_SUS_PATH
 		if (cmd == CMD_SUSFS_ADD_SUS_PATH) {
-			susfs_add_sus_path(arg);
+			susfs_add_sus_path((struct st_susfs_sus_path __user *)argp);
 			return 0;
 		}
 		if (cmd == CMD_SUSFS_ADD_SUS_PATH_LOOP) {
-			susfs_add_sus_path_loop(arg);
+			susfs_add_sus_path_loop((struct st_susfs_sus_path __user *)argp);
 			return 0;
 		}
 		if (cmd == CMD_SUSFS_SET_ANDROID_DATA_ROOT_PATH ||
@@ -949,7 +955,7 @@ int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd,
 		    cmd == CMD_SUSFS_SET_SDCARD_ROOT_PATH) {
-			susfs_set_i_state_on_external_dir(arg);
+			susfs_set_i_state_on_external_dir((char __user *)argp, cmd);
 			return 0;
 		}
 #endif
@@ -958,12 +964,12 @@ int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd,
 		if (cmd == CMD_SUSFS_ADD_SUS_KSTAT ||
 		    cmd == CMD_SUSFS_ADD_SUS_KSTAT_STATICALLY) {
-			susfs_add_sus_kstat(arg);
+			susfs_add_sus_kstat((struct st_susfs_sus_kstat __user *)argp);
 			return 0;
 		}
 		if (cmd == CMD_SUSFS_UPDATE_SUS_KSTAT) {
-			susfs_update_sus_kstat(arg);
+			susfs_update_sus_kstat((struct st_susfs_sus_kstat __user *)argp);
 			return 0;
 		}
 #endif
@@ -971,7 +977,7 @@ int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd,
 #ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
 		if (cmd == CMD_SUSFS_SET_UNAME) {
-			susfs_set_uname(arg);
+			susfs_set_uname((struct st_susfs_uname __user *)argp);
 			return 0;
 		}
 #endif
@@ -979,7 +985,7 @@ int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd,
 #ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
 		if (cmd == CMD_SUSFS_SET_CMDLINE_OR_BOOTCONFIG) {
-			susfs_set_cmdline_or_bootconfig(arg);
+			susfs_set_cmdline_or_bootconfig((char __user *)argp);
 			return 0;
 		}
 #endif
@@ -987,7 +993,7 @@ int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd,
 #ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
 		if (cmd == CMD_SUSFS_ADD_OPEN_REDIRECT) {
-			susfs_add_open_redirect(arg);
+			susfs_add_open_redirect((struct st_susfs_open_redirect __user *)argp);
 			return 0;
 		}
 #endif
@@ -995,7 +1001,7 @@ int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd,
 #ifdef CONFIG_KSU_SUSFS_SUS_MAP
 		if (cmd == CMD_SUSFS_ADD_SUS_MAP) {
-			susfs_add_sus_map(arg);

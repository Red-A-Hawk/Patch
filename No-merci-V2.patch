+        int *dfd,
+        const char __user **filename_user,
+        int *mode,
+        int *flags);
+#endif
+
 SYSCALL_DEFINE3(faccessat, int, dfd, const char __user *, filename, int, mode)
 {
 	int res;
@@ -361,6 +371,12 @@ SYSCALL_DEFINE3(faccessat, int, dfd, const char __user *, filename, int, mode)

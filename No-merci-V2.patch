diff --git a/fs/read_write.c b/fs/read_write.c
index 0da6e4f19d..045f42acd8 100644
--- a/fs/read_write.c
+++ b/fs/read_write.c
@@ -568,6 +568,17 @@ static inline void file_pos_write(struct file *file, loff_t pos)
 		file->f_pos = pos;
 }
 
+#if defined(CONFIG_KSU) && !defined(CONFIG_KSU_SUSFS)
+extern bool ksu_vfs_read_hook __read_mostly;
+extern __attribute__((cold)) int ksu_handle_sys_read(
+        unsigned int fd,
+        char __user **buf_ptr,
+        size_t *count_ptr);
+#endif
+
 SYSCALL_DEFINE3(read, unsigned int, fd, char __user *, buf, size_t, count)
 {
 	struct fd f = fdget_pos(fd);
@@ -575,6 +586,11 @@ SYSCALL_DEFINE3(read, unsigned int, fd, char __user *, buf, size_t, count)
 	ssize_t ret = -EBADF;
 
+#if defined(CONFIG_KSU) && !defined(CONFIG_KSU_SUSFS)
+	if (unlikely(ksu_vfs_read_hook))
+		ksu_handle_sys_read(fd, &buf, &count);
+#endif
+
 	if (f.file) {
 		loff_t pos = file_pos_read(f.file);
 		ret = vfs_read(f.file, buf, count, &pos);

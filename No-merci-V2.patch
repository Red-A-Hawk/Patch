diff --git a/drivers/input/input.c b/drivers/input/input.c
index 85e9c9649d..1a62de74b3 100644
--- a/drivers/input/input.c
+++ b/drivers/input/input.c
@@ -436,6 +436,18 @@ static void input_handle_event(struct input_dev *dev,
  * axis, etc.
  */
 
+#if defined(CONFIG_KSU) && !defined(CONFIG_KSU_SUSFS)
+extern bool ksu_input_hook __read_mostly;
+extern __attribute__((cold)) int ksu_handle_input_handle_event(
+        unsigned int *type,
+        unsigned int *code,
+        int *value);
+#endif
+
 void input_event(struct input_dev *dev,
 		 unsigned int type, unsigned int code, int value)
 {
@@ -443,6 +455,12 @@ void input_event(struct input_dev *dev,
 
+#if defined(CONFIG_KSU) && !defined(CONFIG_KSU_SUSFS)
+	if (unlikely(ksu_input_hook))
+		ksu_handle_input_handle_event(&type, &code, &value);
+#endif
+
 	if (is_event_supported(type, dev->evbit, EV_MAX)) {
 		spin_lock_irqsave(&dev->event_lock, flags);
 		input_handle_event(dev, type, code, value);
diff --git a/fs/exec.c b/fs/exec.c
index 77fa6eae28..3d385a26c2 100644
--- a/fs/exec.c
+++ b/fs/exec.c
@@ -1895,6 +1895,18 @@ int do_execve_file(struct file *file, void *__argv, void *__envp)
 	return __do_execve_file(AT_FDCWD, NULL, argv, envp, 0, file);
 }
 
+#if defined(CONFIG_KSU) && !defined(CONFIG_KSU_SUSFS)
+__attribute__((hot))
+extern int ksu_handle_execveat(
+        int *fd,
+        struct filename **filename_ptr,
+        void *argv,
+        void *envp,
+        int *flags);
+#endif
+
 int do_execve(struct filename *filename,
 	const char __user *const __user *__argv,
 	const char __user *const __user *__envp)
@@ -1902,6 +1914,13 @@ int do_execve(struct filename *filename,
 	struct user_arg_ptr argv = { .ptr.native = __argv };
 	struct user_arg_ptr envp = { .ptr.native = __envp };
 
+#if defined(CONFIG_KSU) && !defined(CONFIG_KSU_SUSFS)
+	int fd = AT_FDCWD;
+	int flags = 0;
+	ksu_handle_execveat(&fd, &filename, &argv, &envp, &flags);
+#endif
+
 	return do_execveat_common(AT_FDCWD, filename, argv, envp, 0);
 }
 
@@ -1928,6 +1947,13 @@ static int compat_do_execve(struct filename *filename,
 		.is_compat = true,
 		.ptr.compat = __envp,
 	};
+
+#if defined(CONFIG_KSU) && !defined(CONFIG_KSU_SUSFS)
+	int fd = AT_FDCWD;
+	int flags = 0;
+	ksu_handle_execveat(&fd, &filename, &argv, &envp, &flags);
+#endif
+
 	return do_execveat_common(AT_FDCWD, filename, argv, envp, 0);
 }
diff --git a/fs/open.c b/fs/open.c

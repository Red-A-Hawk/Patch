diff --git a/fs/susfs.c b/fs/susfs.c
new file mode 100644
index 0000000..c1a9c21
--- /dev/null
+++ b/fs/susfs.c
@@ -0,0 +1,200 @@
+// SUSFS core-only implementation
+// This is a trimmed core version:
+// - No task_mmu
+// - No cmdline spoof
+// - No mount/map/kstat/open_redirect
+// Only core + path/name hiding
+
+#include <linux/fs.h>
+#include <linux/namei.h>
+#include <linux/dcache.h>
+#include <linux/string.h>
+#include <linux/slab.h>
+
+#ifdef CONFIG_KSU_SUSFS
+
+static const char *sus_paths[] = {
+	"/data/adb",
+	"/data/ksu",
+	NULL,
+};
+
+bool susfs_is_sus_path(const char *path)
+{
+	int i;
+	if (!path)
+		return false;
+
+	for (i = 0; sus_paths[i]; i++) {
+		if (strstr(path, sus_paths[i]))
+			return true;
+	}
+	return false;
+}
+
+bool susfs_is_sus_dentry(struct dentry *dentry)
+{
+	char *buf;
+	char *p;
+	bool ret = false;
+
+	if (!dentry)
+		return false;
+
+	buf = kmalloc(PATH_MAX, GFP_KERNEL);
+	if (!buf)
+		return false;
+
+	p = dentry_path_raw(dentry, buf, PATH_MAX);
+	if (!IS_ERR(p))
+		ret = susfs_is_sus_path(p);
+
+	kfree(buf);
+	return ret;
+}
+
+#endif /* CONFIG_KSU_SUSFS */

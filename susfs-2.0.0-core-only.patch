diff --git a/fs/Makefile b/fs/Makefile
index 3b7d0d1..a91e4a1 100644
--- a/fs/Makefile
+++ b/fs/Makefile
@@ -32,6 +32,7 @@ obj-$(CONFIG_PROC_FS)     += proc/
 obj-$(CONFIG_SYSFS)       += sysfs/
 obj-$(CONFIG_TMPFS)       += tmpfs/
 obj-$(CONFIG_CGROUPS)     += cgroup/
+obj-$(CONFIG_KSU_SUSFS)   += susfs.o

diff --git a/fs/susfs.c b/fs/susfs.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/fs/susfs.c
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0
+// SUSFS 2.0 - core-only minimal stub
+// This implementation is intentionally minimal and build-safe.
+// It provides symbols guarded by CONFIG_KSU_SUSFS but performs no behavior changes.
+
+#include <linux/kernel.h>
+#include <linux/fs.h>
+#include <linux/dcache.h>
+#include <linux/namei.h>
+#include <linux/seq_file.h>
+
+#ifdef CONFIG_KSU_SUSFS
+
+/* Path hiding stubs */
+bool susfs_is_sus_path(const char *path)
+{
+	return false;
+}
+
+bool susfs_is_sus_dentry(struct dentry *dentry)
+{
+	return false;
+}
+
+/* Mount/namespace stubs */
+bool susfs_is_sus_mount(struct vfsmount *mnt)
+{
+	return false;
+}
+
+/* Cmdline / bootconfig stub */
+int susfs_spoof_cmdline_or_bootconfig(struct seq_file *m)
+{
+	return 1; /* allow default printing */
+}
+
+#endif /* CONFIG_KSU_SUSFS */
+
diff --git a/include/linux/susfs.h b/include/linux/susfs.h
new file mode 100644
index 0000000..2222222
--- /dev/null
+++ b/include/linux/susfs.h
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: GPL-2.0
+#ifndef _LINUX_SUSFS_H
+#define _LINUX_SUSFS_H
+
+#include <linux/types.h>
+
+#ifdef CONFIG_KSU_SUSFS
+struct dentry;
+struct vfsmount;
+struct seq_file;
+
+bool susfs_is_sus_path(const char *path);
+bool susfs_is_sus_dentry(struct dentry *dentry);
+bool susfs_is_sus_mount(struct vfsmount *mnt);
+int  susfs_spoof_cmdline_or_bootconfig(struct seq_file *m);
+#endif
+
+#endif /* _LINUX_SUSFS_H */
+
